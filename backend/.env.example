# IntelliClaim Environment Configuration

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-intelliclaim-secret-key-change-in-production-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Neon PostgreSQL Database URL
# Example: postgresql://<user>:<password>@<ep-pooler-xxxxxx>.us-east-2.aws.neon.tech/intelliclaim?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/intelliclaim?sslmode=require

# Groq Cloud API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

